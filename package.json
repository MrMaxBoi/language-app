{
  "name": "mern-hotel",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon backend/server.js",
    "build": "npm install && npm install --prefix frontend && npm run build --prefix frontend",
    "start": "NODE_ENV=production node backend/server.js",
    "mobile:start": "npm run start --prefix mobile",
    "mobile:web": "npm run web --prefix mobile",
    "mobile:lint": "npm run lint --prefix mobile",
    "mobile:typecheck": "npx tsc --noEmit -p mobile/tsconfig.json",
    "ci-check": "node backend/server.js & sleep 5 && kill $!",
    "seed:questions": "node backend/seeds/question.seed.js",
    "seed:questions:reset": "node backend/seeds/question.seed.js --reset",
    "seed:questions:dry-run": "node backend/seeds/question.seed.js --dry-run",
    "audit:question-bank": "node backend/scripts/auditQuestionBank.js",
    "audit:question-bank:write": "node backend/scripts/auditQuestionBank.js --write",
    "audit:question-types": "node backend/scripts/auditQuestionTypes.js",
    "audit:question-types:write": "node backend/scripts/auditQuestionTypes.js --write",
    "audit:question-options": "node backend/scripts/auditQuestionOptions.js",
    "audit:question-options:write": "node backend/scripts/auditQuestionOptions.js --write",
    "migrate:question-options:dry-run": "node backend/scripts/migrateQuestionOptions.js",
    "migrate:question-options": "node backend/scripts/migrateQuestionOptions.js --apply",
    "migrate:curated-options:dry-run": "node backend/scripts/migrateCuratedOptions.js",
    "migrate:curated-options": "node backend/scripts/migrateCuratedOptions.js --apply",
    "migrate:question-types:dry-run": "node backend/scripts/migrateQuestionTypes.js",
    "migrate:question-types": "node backend/scripts/migrateQuestionTypes.js --apply",
    "audit:learner": "node backend/scripts/auditLearner.js",
    "audit:learner:write": "node backend/scripts/auditLearner.js --write",
    "backfill:attempt-user-ids": "node backend/scripts/backfillAttemptUserIds.js",
    "backfill:attempt-user-ids:dry-run": "node backend/scripts/backfillAttemptUserIds.js --dry-run",
    "backfill:skill-graph": "node backend/scripts/backfillSkillGraph.js",
    "audit:skill-duplicates": "node backend/scripts/auditSkillGraphDuplicates.js",
    "merge:skill-duplicates": "node backend/scripts/mergeSkillGraphDuplicates.js",
    "merge:skill-duplicates:apply": "node backend/scripts/mergeSkillGraphDuplicates.js --apply",
    "report:skill-gaps": "node backend/scripts/reportSkillQuestionGaps.js",
    "report:skill-gaps:write": "node backend/scripts/reportSkillQuestionGaps.js --write"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "mongodb": "^7.3.0",
    "mongoose": "^8.18.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodeman": "^1.1.2",
    "nodemon": "^3.1.10"
  }
}
